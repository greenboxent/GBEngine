{
    "name": "{{SLUG}}",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run bump && vite build",
        "preview": "vite preview",
        "bump": "node node_modules/@gamebase/gbengine/scripts/bump-version.js",
        "build:dev": "vite build --mode development",
        "android:dev": "node node_modules/@gamebase/gbengine/scripts/android-config.mjs dev && npm run build:dev && npx cap sync android",
        "android:prod": "node node_modules/@gamebase/gbengine/scripts/android-config.mjs prod && npm run build && npx cap sync android",
        "android:release": "npm run android:prod && node node_modules/@gamebase/gbengine/scripts/android-config.mjs prod --build",
        "deploy:dev": "npm run build:dev && firebase deploy -P dev",
        "deploy:prod": "npm run build && firebase deploy -P prod",
        "reset:prod": "node node_modules/@gamebase/gbengine/scripts/firebase-reset.mjs --project {{SLUG}}-prod --paths playerNames,{{SLUG}}-leaderboard,{{SLUG}}-settings,games/{{SLUG}}/personalScores"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5",
        "@capacitor/cli": "^8.4.2",
        "terser": "^5.49.0",
        "vite": "^7.2.4"
    },
    "dependencies": {
        "@capacitor-community/admob": "^8.0.0",
        "@capacitor-firebase/authentication": "^8.1.0",
        "@capacitor/android": "^8.0.1",
        "@capacitor/app": "^8.0.1",
        "@capacitor/core": "^8.0.1",
        "@capacitor/device": "^8.0.3",
        "@capgo/native-purchases": "^8.3.0",
        "@gamebase/gbengine": "{{GBENGINE_DEP}}",
        "firebase": "^12.8.0",
        "phaser": "^4.1.0"
    }
}
